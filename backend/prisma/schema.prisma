datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            Int           @id @default(autoincrement())
  nameCategory  String        @unique
  slug          String        @unique
  subCategories SubCategory[] // La categoria ha molte sottocategorie
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id              Int         @id @default(autoincrement())
  nameSubCategory String
  slug            String      @unique
  categoryId      Int
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products        Product[]   // La sottocategoria ha molti prodotti
  createdAt       DateTime    @default(now())

  @@unique([nameSubCategory, categoryId])
}

model Franchise {
  id            Int       @id @default(autoincrement())
  nameFranchise String    @unique
  slug          String    @unique
  products      Product[]
  createdAt     DateTime  @default(now())
}

// TABELLA MADRE: Centralizza tutto
model Product {
  id            Int          @id @default(autoincrement())
  name          String
  price         Decimal      @db.Decimal(10, 2)
  stock         Int          @default(0)
  isAvailable   Boolean      @default(false)
  type          String       // "CARD", "FUNKO", "MANGA", "BOARDGAME"
  subCategoryId Int
  subCategory   SubCategory  @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  franchiseId   Int
  franchise     Franchise    @relation(fields: [franchiseId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  // Relazioni 1-a-1 opzionali verso i dettagli specifici
  cardId        Int?         @unique
  card          Card?        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  funkoPopId    Int?         @unique
  funkoPop      FunkoPop?    @relation(fields: [funkoPopId], references: [id], onDelete: Cascade)
  
  mangaId       Int?         @unique
  manga         Manga?       @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  // Relazione 1-a-1 per i Giochi da Tavolo
  boardGameId   Int?         @unique
  boardGame     BoardGame?   @relation(fields: [boardGameId], references: [id], onDelete: Cascade)
}

// TABELLES FIGLIE: Contengono SOLO i campi extra del tipo specifico
model Card {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  number     String
  rarity     String
  set        String
  variant    String
  product    Product?
}

model FunkoPop {
  id               Int      @id @default(autoincrement())
  boxNumber        Int
  isChase          Boolean  @default(false)
  stickerExclusive String?
  product          Product?
}

model Manga {
  id           Int      @id @default(autoincrement())
  externalId   Int      @unique  // ID univoco di MyAnimeList
  volumeNumber Int
  author       String
  publisher    String
  synopsis     String?
  imageUrl     String?
  product      Product?
}

model BoardGame {
  id            Int      @id @default(autoincrement())
  bggId         Int      @unique  // ID univoco di BoardGameGeek
  description   String?  @db.Text // Descrizione completa
  imageUrl      String?  // Copertina HD
  thumbnailUrl  String?  // Miniatura
  minPlayers    Int?     // Min giocatori
  maxPlayers    Int?     // Max giocatori
  playingTime   Int?     // Durata media
  minPlayTime   Int?     // Durata minima
  maxPlayTime   Int?     // Durata massima
  minAge        Int?     // Età consigliata
  yearPublished Int?     // Anno di rilascio
  product       Product?
}