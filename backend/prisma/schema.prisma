datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  subCategories SubCategory[]
}

model SubCategory {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@unique([name, categoryId])
}

model Product {
  id            Int          @id @default(autoincrement())
  name          String
  price         Decimal      @db.Decimal(10, 2)
  stock         Int          @default(0)
  isAvailable   Boolean      @default(false)
  imageUrl      String?
  externalId    String       @unique
  tcgplayerId   String?      // ID specifico di TCGPlayer (opzionale)
  number        String?      // Numero/Codice della carta (es. DB1-EN098)
  rarity        String?      // Rarità della carta (es. Ultra Rare)
  set           String?      // Nome del set/espansione (es. Dark Beginning 1)
  variant       String?      // Variante della carta (es. Unlimited, 1st Edition)
  subCategoryId Int
  subCategory   SubCategory  @relation(fields: [subCategoryId], references: [id])
  createdAt     DateTime     @default(now())
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}