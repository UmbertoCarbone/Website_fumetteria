// ============================================================
// SCHEMA PRISMA — Catalogo multi-brand (fumetteria) v2
// ============================================================
// Category  = TIPO di prodotto (Carte, Manga, Funko, Giochi)
// Franchise = BRAND trasversale (Pokemon, Naruto, One Piece)
// Product   = tabella madre, pulita, senza colonne per-tipo
// *Detail   = tabelle figlie con FK verso Product (non viceversa)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ⚠️ NON TOCCATA — esattamente come l'hai incollata
// ------------------------------------------------------------

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// CATEGORY — solo il tipo di prodotto, un livello (no SubCategory)
// ------------------------------------------------------------

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique // "Carte", "Manga", "Funko", "Giochi da Tavolo"
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// ------------------------------------------------------------
// FRANCHISE — il brand, trasversale a tutti i tipi
// ------------------------------------------------------------

model Franchise {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  slug      String           @unique
  aliases   FranchiseAlias[]
  products  Product[]
  createdAt DateTime         @default(now())
}

// Ogni API nomina i franchise in modo diverso: mappa qui la
// stringa esatta ricevuta -> il Franchise canonico, prima
// di creare/collegare il Product.
model FranchiseAlias {
  id          Int            @id @default(autoincrement())
  alias       String
  source      ExternalSource
  franchiseId Int
  franchise   Franchise      @relation(fields: [franchiseId], references: [id])

  @@unique([alias, source])
}

enum ExternalSource {
  TCG_PRICE_LOOKUP
  JIKAN          // se in futuro passi a MyAnimeList/Jikan invece di AniList
  ANILIST        // non più usata da mangaController (sostituita da MANGADEX), lasciata per lo storico
  MANGADEX       // fonte manga per-volume: numero volumi reale + copertina per singolo volume
  BGG            // BoardGameGeek
  FUNKO_DATASET  // dataset open-source GitHub (kennymkchan/funko-pop-data)
  MANUAL
}

// ------------------------------------------------------------
// PRODUCT — tabella madre, SENZA colonne per-tipo
// ------------------------------------------------------------

model Product {
  id             Int             @id @default(autoincrement())
  sku            String          @unique
  name           String
  description    String?
  images         String[]
  price          Decimal         @db.Decimal(10, 2)
  stock          Int             @default(0)
  isAvailable    Boolean         @default(true) // ricalcolato a mano ad ogni write in base a stock

  categoryId     Int
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  franchiseId    Int?            // opzionale: prodotti generici senza brand
  franchise      Franchise?      @relation(fields: [franchiseId], references: [id], onDelete: Restrict)

  externalId     String?
  externalSource ExternalSource?

  card           Card?
  funkoPop       FunkoPop?
  manga          Manga?
  boardGame      BoardGame?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([externalId, externalSource]) // sync idempotente: ri-fetch senza duplicati
  @@index([categoryId, franchiseId])     // query più frequente: "carte di One Piece"
}

// ------------------------------------------------------------
// DETTAGLI PER TIPO — FK unica verso Product (verso invertito
// rispetto alla tua versione: la figlia punta alla madre)
// ------------------------------------------------------------

model Card {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  number    String
  rarity    String
  set       String
  variant   String

  @@index([set])
}

model FunkoPop {
  id               Int     @id @default(autoincrement())
  productId        Int     @unique
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  boxNumber        Int?
  isChase          Boolean @default(false)
  stickerExclusive String?
}

model Manga {
  id           Int      @id @default(autoincrement())
  productId    Int      @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  volume       Int?
  authors      String[]
  chapters     Int?
  synopsis     String?
  score        Float?
  status       String?
}

model BoardGame {
  id            Int     @id @default(autoincrement())
  productId     Int     @unique
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  minPlayers    Int?
  maxPlayers    Int?
  playingTime   Int?
  minPlayTime   Int?
  maxPlayTime   Int?
  minAge        Int?
  yearPublished Int?
}
